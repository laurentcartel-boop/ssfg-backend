const { Op } = require('sequelize');
const { AccountingEntry, User } = require('../models');

function num(v) {
  if (v === null || v === undefined || v === '') return 0;
  let s = String(v).trim();
  // Erreurs Excel / cellules invalides
  if (/^#+(VALUE|DIV|REF|N\/A|NAME|NULL|NUM|GETTING_DATA)!?$/i.test(s)) return 0;
  if (/^#Value$/i.test(s) || s === '#VALUE!' || s === '#Value') return 0;
  if (s === '-' || s === '—' || s === '–') return 0;
  s = s.replace(/\s/g, '').replace(',', '.').replace(/€/g, '');
  // enlever espaces insécables
  s = s.replace(/\u00a0/g, '');
  const n = Number(s);
  return Number.isFinite(n) ? n : 0;
}

function isJunkLabel(label) {
  const s = String(label || '').trim();
  if (!s) return true;
  if (/^#/.test(s)) return true;
  if (/^n°?\s*$/i.test(s)) return true;
  return false;
}

function detectType(row) {
  const t = String(row.entry_type || row.Type || row.type || '').toUpperCase();
  if (t.includes('REPORT')) return 'REPORT';
  if (t.includes('RECETTE')) return 'RECETTE';
  if (t.includes('DEPENSE') || t.includes('DÉPENSE')) return 'DEPENSE';
  const recipes = num(row.recipes ?? row.Recettes ?? row.recettes);
  const expenses = num(row.expenses ?? row.Dépenses ?? row.Depenses ?? row.depenses);
  if (recipes > 0 && expenses <= 0) return 'RECETTE';
  if (expenses > 0 && recipes <= 0) return 'DEPENSE';
  if (String(row.account_number || row['N° compte'] || '').startsWith('11')) return 'REPORT';
  return expenses >= recipes ? 'DEPENSE' : 'RECETTE';
}

function parseDate(v) {
  if (!v) return null;
  const s = String(v).trim();
  // YYYY-MM-DD
  if (/^\d{4}-\d{2}-\d{2}/.test(s)) return s.slice(0, 10);
  // DD/MM/YYYY
  const m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
  if (m) return `${m[3]}-${m[2].padStart(2, '0')}-${m[1].padStart(2, '0')}`;
  const d = new Date(s);
  if (!Number.isNaN(d.getTime())) return d.toISOString().slice(0, 10);
  return null;
}

/** Parse CSV simple (séparateur ; ou ,) */
function parseCsv(text) {
  const lines = text.replace(/\r\n/g, '\n').replace(/\r/g, '\n').split('\n').filter((l) => l.trim());
  if (lines.length < 2) return [];
  const sep = lines[0].includes(';') ? ';' : ',';
  const headers = lines[0].split(sep).map((h) => h.trim().replace(/^"|"$/g, ''));
  const rows = [];
  for (let i = 1; i < lines.length; i++) {
    const cols = [];
    let cur = '';
    let inQ = false;
    const line = lines[i];
    for (let c = 0; c < line.length; c++) {
      const ch = line[c];
      if (ch === '"') {
        inQ = !inQ;
      } else if (ch === sep && !inQ) {
        cols.push(cur.trim());
        cur = '';
      } else {
        cur += ch;
      }
    }
    cols.push(cur.trim());
    const obj = {};
    headers.forEach((h, idx) => {
      obj[h] = (cols[idx] || '').replace(/^"|"$/g, '');
    });
    rows.push(obj);
  }
  return rows;
}

function pick(raw, keys) {
  for (const k of keys) {
    if (raw[k] !== undefined && raw[k] !== null && String(raw[k]).trim() !== '') {
      return raw[k];
    }
  }
  // match header keys case-insensitive / accent-insensitive-ish
  const entries = Object.entries(raw);
  for (const want of keys) {
    const w = String(want).toLowerCase().normalize('NFD').replace(/\p{M}/gu, '');
    for (const [k, v] of entries) {
      const kk = String(k).toLowerCase().normalize('NFD').replace(/\p{M}/gu, '');
      if (kk === w || kk.includes(w)) {
        if (v !== undefined && v !== null && String(v).trim() !== '') return v;
      }
    }
  }
  return undefined;
}

function mapRow(raw, defaultYear) {
  let recipes = num(
    pick(raw, ['Recettes', 'recettes', 'recipes', 'Banque Recettes', 'Banque recettes'])
  );
  let expenses = num(
    pick(raw, ['Dépenses', 'Depenses', 'depenses', 'expenses', 'Banque Dépenses', 'Banque Depenses'])
  );
  let amount = num(pick(raw, ['Montant', 'montant', 'amount']));
  if (!amount) amount = Math.max(recipes, expenses);

  const entry_date =
    parseDate(pick(raw, ['Date', 'date', 'entry_date'])) ||
    (defaultYear ? `${defaultYear}-01-01` : null);

  const label = pick(raw, [
    'Libellé',
    'Libelle',
    'libelle',
    'label',
    'Libellé pour AG',
    'Libelle pour AG',
  ]) || 'Écriture';

  if (!entry_date || isJunkLabel(label)) return null;
  if (amount === 0 && recipes === 0 && expenses === 0) return null;

  const account_number = String(
    pick(raw, ['N° compte', 'N compte', 'Compte', 'account_number', 'compte']) || ''
  ).slice(0, 20) || null;

  let entry_type = detectType({
    entry_type: pick(raw, ['Type', 'type', 'entry_type', 'Classe']),
    recipes,
    expenses,
    account_number,
  });

  // Si Type/Classe = CHARGES → dépense ; PRODUITS → recette
  const classe = String(pick(raw, ['Classe', 'classe', 'Type', 'type']) || '').toUpperCase();
  if (classe.includes('CHARGE')) entry_type = 'DEPENSE';
  if (classe.includes('PRODUIT')) entry_type = 'RECETTE';
  if (classe.includes('REPORT') || String(account_number || '').startsWith('11')) entry_type = 'REPORT';

  // Répartir le montant si recettes/dépenses vides
  if (entry_type === 'RECETTE') {
    if (!recipes) recipes = amount;
  } else if (entry_type === 'DEPENSE') {
    if (!expenses) expenses = amount;
  } else if (entry_type === 'REPORT') {
    // report à nouveau créditeur souvent en recettes
    if (!recipes && !expenses) recipes = amount;
  }

  const year = defaultYear || Number(String(entry_date).slice(0, 4));
  const ag = pick(raw, ['Libellé pour AG', 'Libelle pour AG', 'ag_label']);
  return {
    year,
    entry_date,
    label: String(label).slice(0, 500),
    ag_label: ag ? String(ag).slice(0, 120) : null,
    account_number,
    account_title: String(
      pick(raw, ['Intitulé', 'Intitule', 'account_title', 'Intitulé complet', 'Intitule complet']) || ''
    ).slice(0, 255) || null,
    amount: amount || recipes || expenses,
    recipes,
    expenses,
    entry_type,
    journal_number: String(pick(raw, ['N°', 'N', 'journal_number', 'No']) || '').slice(0, 20) || null,
  };
}

async function listEntries(req, res) {
  try {
    const where = {};
    if (req.query.year) where.year = Number(req.query.year);
    if (req.query.type) where.entry_type = req.query.type;
    const entries = await AccountingEntry.findAll({
      where,
      order: [
        ['entry_date', 'ASC'],
        ['journal_number', 'ASC'],
        ['createdAt', 'ASC'],
      ],
    });
    res.json({ entries });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function summary(req, res) {
  try {
    const year = Number(req.query.year) || new Date().getFullYear();
    const entries = await AccountingEntry.findAll({ where: { year } });
    let totalRecipes = 0;
    let totalExpenses = 0;
    let reportAmount = 0; // solde d'ouverture / report à nouveau (recettes de type REPORT)
    const byAg = {};
    const byAccount = {};
    let suspicious = 0;

    for (const e of entries) {
      let r = Number(e.recipes) || 0;
      let x = Number(e.expenses) || 0;
      const amt = Number(e.amount) || 0;
      if (e.entry_type === 'REPORT') {
        if (!r && !x && amt) r = amt;
        reportAmount += r - x;
        continue;
      }
      if (!r && !x && amt) {
        if (e.entry_type === 'RECETTE') r = amt;
        else x = amt;
      }
      totalRecipes += r;
      totalExpenses += x;
      const ag = e.ag_label || 'Divers';
      if (!byAg[ag]) byAg[ag] = { recipes: 0, expenses: 0 };
      byAg[ag].recipes += r;
      byAg[ag].expenses += x;
      const acc = e.account_number || '—';
      if (!byAccount[acc]) byAccount[acc] = { title: e.account_title, recipes: 0, expenses: 0 };
      byAccount[acc].recipes += r;
      byAccount[acc].expenses += x;
      if (String(e.label || '').startsWith('#')) suspicious += 1;
    }

    const result = Math.round((totalRecipes - totalExpenses) * 100) / 100;
    // Banque estimée = report ouverture + recettes exercice - dépenses exercice
    const bank = Math.round((reportAmount + totalRecipes - totalExpenses) * 100) / 100;
    const reportRounded = Math.round(reportAmount * 100) / 100;

    res.json({
      year,
      total_recipes: Math.round(totalRecipes * 100) / 100,
      total_expenses: Math.round(totalExpenses * 100) / 100,
      result,
      report_a_nouveau: reportRounded,
      bilan: {
        actif: {
          compte_courant: bank,
          livret_a: 0,
          total: bank,
        },
        passif: {
          report_a_nouveau: reportRounded,
          resultat_exercice: result,
          total: Math.round((reportRounded + result) * 100) / 100,
        },
        // Actif = Passif si tout est en banque (compta de trésorerie)
        equilibre: Math.abs(bank - (reportRounded + result)) < 0.02,
      },
      by_ag_label: byAg,
      by_account: byAccount,
      count: entries.length,
      suspicious_labels: suspicious,
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function years(req, res) {
  try {
    const rows = await AccountingEntry.findAll({
      attributes: ['year'],
      group: ['year'],
      order: [['year', 'DESC']],
    });
    const list = rows.map((r) => r.year);
    res.json({ years: list.length ? list : [new Date().getFullYear()] });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function createEntry(req, res) {
  try {
    const body = req.body || {};
    const entry_date = parseDate(body.entry_date);
    if (!entry_date || !body.label) {
      return res.status(400).json({ error: 'Date et libellé requis' });
    }
    const recipes = num(body.recipes);
    const expenses = num(body.expenses);
    let amount = num(body.amount);
    if (!amount) amount = Math.max(recipes, expenses);
    let entry_type = body.entry_type || detectType({ recipes, expenses, entry_type: body.entry_type });
    const year = Number(body.year) || Number(entry_date.slice(0, 4));
    const entry = await AccountingEntry.create({
      year,
      entry_date,
      label: String(body.label).slice(0, 500),
      ag_label: body.ag_label || null,
      account_number: body.account_number || null,
      account_title: body.account_title || null,
      amount,
      recipes: entry_type === 'RECETTE' ? recipes || amount : recipes,
      expenses: entry_type === 'DEPENSE' ? expenses || amount : expenses,
      entry_type,
      journal_number: body.journal_number || null,
      notes: body.notes || null,
      created_by: req.user.id,
    });
    res.status(201).json({ entry });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function updateEntry(req, res) {
  try {
    const entry = await AccountingEntry.findByPk(req.params.id);
    if (!entry) return res.status(404).json({ error: 'Écriture introuvable' });
    const body = req.body || {};
    const fields = {};
    if (body.entry_date) fields.entry_date = parseDate(body.entry_date);
    if (body.label != null) fields.label = String(body.label).slice(0, 500);
    if (body.ag_label != null) fields.ag_label = body.ag_label;
    if (body.account_number != null) fields.account_number = body.account_number;
    if (body.account_title != null) fields.account_title = body.account_title;
    if (body.amount != null) fields.amount = num(body.amount);
    if (body.recipes != null) fields.recipes = num(body.recipes);
    if (body.expenses != null) fields.expenses = num(body.expenses);
    if (body.entry_type) fields.entry_type = body.entry_type;
    if (body.year != null) fields.year = Number(body.year);
    if (body.notes != null) fields.notes = body.notes;
    await entry.update(fields);
    res.json({ entry });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function deleteEntry(req, res) {
  try {
    const entry = await AccountingEntry.findByPk(req.params.id);
    if (!entry) return res.status(404).json({ error: 'Écriture introuvable' });
    await entry.destroy();
    res.json({ message: 'Écriture supprimée' });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function deleteYear(req, res) {
  try {
    const year = Number(req.params.year);
    if (!year) return res.status(400).json({ error: 'Année invalide' });
    const n = await AccountingEntry.destroy({ where: { year } });
    res.json({ message: `${n} écriture(s) supprimée(s) pour ${year}` });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

/**
 * POST body: { year, csv } ou { year, rows: [...] }
 */
async function importEntries(req, res) {
  try {
    const year = Number(req.body.year);
    if (!year) return res.status(400).json({ error: 'year requis' });
    let mapped = [];
    if (req.body.csv && typeof req.body.csv === 'string') {
      const rawRows = parseCsv(req.body.csv);
      mapped = rawRows.map((r) => mapRow(r, year)).filter(Boolean);
    } else if (Array.isArray(req.body.rows)) {
      mapped = req.body.rows.map((r) => mapRow(r, year)).filter(Boolean);
    } else {
      return res.status(400).json({ error: 'csv ou rows requis' });
    }
    if (!mapped.length) {
      return res.status(400).json({ error: 'Aucune ligne valide trouvée' });
    }
    const replace = req.body.replace === true || req.body.replace === '1';
    if (replace) {
      await AccountingEntry.destroy({ where: { year } });
    }
    const created = await AccountingEntry.bulkCreate(
      mapped.map((m) => ({ ...m, created_by: req.user.id }))
    );
    res.status(201).json({
      message: `${created.length} écriture(s) importée(s) pour ${year}`,
      count: created.length,
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}


/** Comptes déjà utilisés (tous exercices) + libellé d’exemple */
async function listAccounts(req, res) {
  try {
    const entries = await AccountingEntry.findAll({
      attributes: ['account_number', 'label', 'ag_label'],
      where: {
        account_number: { [require('sequelize').Op.ne]: null },
      },
      order: [['account_number', 'ASC']],
      limit: 5000,
    });
    const map = new Map();
    for (const e of entries) {
      const num = String(e.account_number || '').trim();
      if (!num || num === '—' || num === '#VALEUR!') continue;
      if (!map.has(num)) {
        map.set(num, {
          account_number: num,
          label: e.ag_label || e.label || '',
        });
      }
    }
    // Comptes types asso souvent utiles si absents
    const defaults = [
      { account_number: '512', label: 'Banque' },
      { account_number: '53', label: 'Caisse' },
      { account_number: '756', label: 'Cotisations' },
      { account_number: '740', label: 'Subventions' },
      { account_number: '77', label: 'Produits divers' },
      { account_number: '606', label: 'Achats non stockés' },
      { account_number: '6063', label: 'Fournitures / équipement' },
      { account_number: '6278', label: 'Frais bancaires' },
      { account_number: '616', label: 'Assurances' },
      { account_number: '622', label: 'Honoraires' },
      { account_number: '628', label: 'Divers (OVH, AFFG…)' },
      { account_number: '862', label: 'Encadrement / prestations' },
      { account_number: '11', label: 'Report à nouveau' },
    ];
    for (const d of defaults) {
      if (!map.has(d.account_number)) map.set(d.account_number, d);
    }
    const accounts = Array.from(map.values()).sort((a, b) =>
      String(a.account_number).localeCompare(String(b.account_number), 'fr', {
        numeric: true,
      })
    );
    res.json({ accounts });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

module.exports = {
  listAccounts,
  listEntries,
  summary,
  years,
