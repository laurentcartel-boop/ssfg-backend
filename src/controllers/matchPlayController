async function getChampionship(req, res) {
  try {
    const c = await MatchPlayChampionship.findByPk(req.params.id, {
      include: [
        { model: User, as: 'creator', attributes: ['id', 'first_name', 'last_name'] },
        {
          model: MatchPlayMatch,
          as: 'matches',
          include: [
            { model: User, as: 'playerA', attributes: ['id', 'first_name', 'last_name'] },
            { model: User, as: 'playerB', attributes: ['id', 'first_name', 'last_name'] },
            { model: User, as: 'winner', attributes: ['id', 'first_name', 'last_name'] },
          ],
        },
      ],
    });
    if (!c) return res.status(404).json({ error: 'Championnat introuvable' });

    const entrantIds = c.entrants || [];
    const players = entrantIds.length
      ? await User.findAll({
          where: { id: entrantIds },
          attributes: ['id', 'first_name', 'last_name', 'index_value'],
        })
      : [];

    const n = entrantIds.length;
    const bracketSize = n >= 2 ? nextPowerOf2(n) : 0;
    const byes = bracketSize - n;

    res.json({
      championship: c,
      players,
      bracket_info: {
        entrants: n,
        bracket_size: bracketSize,
        byes,
        odd: n % 2 === 1,
        message:
          n < 2
            ? 'Au moins 2 inscrits requis'
            : byes > 0
              ? `${n} inscrits → tableau de ${bracketSize} : ${n - byes} joueurs jouent le 1er tour (${(n - byes) / 2} matchs), ${byes} bye(s) → ${bracketSize / 2} qualifiés.`
              : `${n} inscrits → tableau complet de ${bracketSize} (${bracketSize / 2} matchs)`,
      },
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

