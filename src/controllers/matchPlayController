/** Super-admin : supprimer un match libre (hors championnat) */
async function deleteMatch(req, res) {
  try {
    const m = await MatchPlayMatch.findByPk(req.params.id);
    if (!m) return res.status(404).json({ error: 'Match introuvable' });
    if (m.championship_id) {
      return res.status(400).json({
        error: 'Match de championnat : supprimez le championnat entier, ou laissez-le',
      });
    }
    await m.destroy();
    res.json({ message: 'Match libre supprimé' });
  } catch (err) {
    console.error('deleteMatch', err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

