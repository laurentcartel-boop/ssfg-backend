async function addEntrants(req, res) {
  try {
    const c = await MatchPlayChampionship.findByPk(req.params.id);
    if (!c) return res.status(404).json({ error: 'Championnat introuvable' });
    if (c.status !== 'open') {
      return res.status(400).json({ error: 'Inscriptions fermées (tableau déjà tiré)' });
    }
    const ids = req.body.player_ids || [];
    if (!Array.isArray(ids) || ids.length === 0) {
      return res.status(400).json({ error: 'player_ids requis' });
    }
    const set = new Set([...(c.entrants || []), ...ids]);
    await c.update({ entrants: [...set] });
    const n = set.size;
    const bracketSize = nextPowerOf2(n);
    const byes = bracketSize - n;
    res.json({
      championship: c,
      message: 'Inscrits mis à jour',
      bracket_info: {
        entrants: n,
        bracket_size: bracketSize,
        byes,
        odd: n % 2 === 1,
        message:
          byes > 0
            ? `${n} inscrits → ${byes} bye(s) au 1er tour (qualification d'office)`
            : `${n} inscrits → tableau complet`,
      },
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

/**
 * Tirage correct :
 * n joueurs → tableau size=2^k.
 * byes = size - n  → qualifications d'office
 * matchs R1 = (size/2 - byes) = n - size/2
 * Exactement size/2 qualifiés pour le tour suivant (jamais 11 pour un tableau de 8).
 */
async function drawBracket(req, res) {
  try {
    const c = await MatchPlayChampionship.findByPk(req.params.id);
    if (!c) return res.status(404).json({ error: 'Championnat introuvable' });
    if (c.status !== 'open') {
      return res.status(400).json({ error: 'Tableau déjà généré' });
    }

    const raw = [...(c.entrants || [])];
    if (raw.length < 2) {
      return res.status(400).json({ error: 'Au moins 2 inscrits' });
    }

    // Charger les index pour classer les inscrits (plus bas = meilleur)
    const userRows = await User.findAll({
      where: { id: raw },
      attributes: ['id', 'index_value', 'last_name', 'first_name'],
    });
    const byId = Object.fromEntries(userRows.map((u) => [u.id, u]));

    // Meilleurs index d'abord (index bas = fort). Index manquant → traité comme très élevé.
    const sorted = [...raw].sort((a, b) => {
      const ia = Number(byId[a]?.index_value);
      const ib = Number(byId[b]?.index_value);
      const va = Number.isFinite(ia) ? ia : 99;
      const vb = Number.isFinite(ib) ? ib : 99;
      if (va !== vb) return va - vb;
      // départage alphabétique
      const na = `${byId[a]?.last_name || ''} ${byId[a]?.first_name || ''}`;
      const nb = `${byId[b]?.last_name || ''} ${byId[b]?.first_name || ''}`;
      return na.localeCompare(nb, 'fr');
    });

    const n = sorted.length;
    const size = nextPowerOf2(n);
    const byesCount = size - n;
    // Byes = les meilleurs (masters / petits index) — quasi sûrs de passer le 1er tour
    const byePlayers = sorted.slice(0, byesCount);
    // Les autres jouent le 1er tour (tirage au sort entre eux pour les duels)
    const playing = shuffle(sorted.slice(byesCount));

    const created = [];
    let slot = 0;

    // 1) Byes d'abord (qualifs d'office)
    for (const pid of byePlayers) {
      const key = c.format === 'home_away' ? seriesKey(c.id, size, slot) : null;
      const byeMatch = await MatchPlayMatch.create({
        championship_id: c.id,
        player_a_id: pid,
        player_b_id: null,
        round_size: size,
        bracket_slot: slot,
        leg: 1,
        series_key: key,
        status: 'closed',
        holes_data: [],
        holes_won_a: 0,
        holes_won_b: 0,
        winner_id: pid,
        is_bye: true,
        created_by: req.user.id,
      });
      created.push(byeMatch);
      await advanceWinner(c, size, slot, pid, req.user.id);
      slot += 1;
    }

    // 2) Vrais duels
    for (let i = 0; i < playing.length; i += 2) {
      const a = playing[i];
      const b = playing[i + 1];
      const key = c.format === 'home_away' ? seriesKey(c.id, size, slot) : null;
      const m = await MatchPlayMatch.create({
        championship_id: c.id,
        player_a_id: a,
        player_b_id: b,
        round_size: size,
        bracket_slot: slot,
        leg: 1,
        series_key: key,
        status: 'pending',
        holes_data: [],
        is_bye: false,
        created_by: req.user.id,
      });
      created.push(m);
      slot += 1;
    }

    await c.update({ status: 'in_progress' });

    const realMatches = playing.length / 2;
    res.json({
      message: `Tirage OK — tableau ${size} : ${realMatches} match(s) + ${byesCount} bye(s) → ${size / 2} qualifiés`,
      matches_created: created.length,
      bracket_size: size,
      byes: byesCount,
      first_round_matches: realMatches,
      warning:
        byesCount > 0
          ? `${byesCount} bye(s) attribués aux meilleurs index (les plus bas). Ils passent directement au tour suivant.`
          : null,
    });
  } catch (err) {
    console.error('drawBracket', err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

