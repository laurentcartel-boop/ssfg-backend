const {
  MatchPlayChampionship,
  MatchPlayMatch,
  User,
} = require('../models');

function summarizeHoles(holes) {
  let a = 0;
  let b = 0;
  for (const h of holes || []) {
    if (h.result === 'a') a += 1;
    else if (h.result === 'b') b += 1;
  }
  return { holes_won_a: a, holes_won_b: b };
}

function nextPowerOf2(n) {
  let p = 1;
  while (p < n) p *= 2;
  return p;
}

function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function seriesKey(champId, roundSize, slot) {
  return `${champId}-R${roundSize}-S${slot}`;
}

/**
 * Place le vainqueur dans le match du tour suivant.
 * Les slots pairs (0,2,4…) → player A ; impairs → player B.
 * Ne crée jamais un match « contre soi-même ».
 */
async function advanceWinner(champ, roundSize, slot, winnerId, createdBy) {
  if (!champ || roundSize == null || slot == null || !winnerId) return null;
  if (roundSize <= 2) {
    // Finale terminée
    return null;
  }

  const nextSize = roundSize / 2;
  const nextSlot = Math.floor(slot / 2);
  const goesToA = slot % 2 === 0;

  let next = await MatchPlayMatch.findOne({
    where: {
      championship_id: champ.id,
      round_size: nextSize,
      bracket_slot: nextSlot,
      leg: 1,
      is_bye: false,
    },
  });

  if (!next) {
    next = await MatchPlayMatch.create({
      championship_id: champ.id,
      player_a_id: goesToA ? winnerId : null,
      player_b_id: goesToA ? null : winnerId,
      round_size: nextSize,
      bracket_slot: nextSlot,
      leg: 1,
      series_key:
        champ.format === 'home_away' ? seriesKey(champ.id, nextSize, nextSlot) : null,
      status: 'pending',
      holes_data: [],
      is_bye: false,
      created_by: createdBy,
    });
    return next;
  }

  // Ne pas écraser un joueur déjà placé avec le même id des deux côtés
  const updates = {};
  if (goesToA) {
    if (next.player_a_id && next.player_a_id !== winnerId) {
      // déjà rempli
    } else {
      updates.player_a_id = winnerId;
    }
  } else if (next.player_b_id && next.player_b_id !== winnerId) {
    // déjà rempli
  } else {
    updates.player_b_id = winnerId;
  }

  if (Object.keys(updates).length) {
    await next.update(updates);
  }

  next = await MatchPlayMatch.findByPk(next.id);

  // Si les deux joueurs sont identiques (bug résiduel) → corriger
  if (
    next.player_a_id &&
    next.player_b_id &&
    next.player_a_id === next.player_b_id
  ) {
    // Garder seulement le côté qui vient d'arriver
    if (goesToA) {
      await next.update({ player_b_id: null });
    } else {
      await next.update({ player_a_id: null });
    }
    next = await MatchPlayMatch.findByPk(next.id);
  }

  return next;
}

