async function updateMatchHoles(req, res) {
  try {
    const match = await MatchPlayMatch.findByPk(req.params.id);
    if (!match) return res.status(404).json({ error: 'Match introuvable' });
    if (match.is_bye) return res.status(400).json({ error: 'Qualifié d\'office (bye)' });
    if (match.status === 'closed') {
      return res.status(400).json({ error: 'Match déjà terminé' });
    }
    if (!match.player_a_id || !match.player_b_id) {
      return res.status(400).json({ error: 'En attente de l\'autre finaliste du tour précédent' });
    }
    if (match.player_a_id === match.player_b_id) {
      return res.status(400).json({ error: 'Match invalide (même joueur des deux côtés)' });
    }

    let holes = Array.isArray(match.holes_data) ? [...match.holes_data] : [];

    if (req.body.holes && Array.isArray(req.body.holes)) {
      holes = req.body.holes;
    } else if (req.body.hole != null && req.body.result) {
      const hole = Number(req.body.hole);
      const result = req.body.result;
      if (!['a', 'b', 'half'].includes(result)) {
        return res.status(400).json({ error: 'result doit être a, b ou half' });
      }
      if (hole < 1 || hole > 18) {
        return res.status(400).json({ error: 'Trou invalide' });
      }
      const idx = holes.findIndex((h) => h.hole === hole);
      if (idx >= 0) holes[idx] = { hole, result };
      else holes.push({ hole, result });
      holes.sort((x, y) => x.hole - y.hole);
    } else {
      return res.status(400).json({ error: 'Données de score manquantes' });
    }

    const { holes_won_a, holes_won_b } = summarizeHoles(holes);
    await match.update({
      holes_data: holes,
      holes_won_a,
      holes_won_b,
      status: match.status === 'pending' ? 'in_progress' : match.status,
    });

    const full = await MatchPlayMatch.findByPk(match.id, {
      include: [
        { model: User, as: 'playerA', attributes: ['id', 'first_name', 'last_name'] },
        { model: User, as: 'playerB', attributes: ['id', 'first_name', 'last_name'] },
      ],
    });
    res.json({ match: full });
  } catch (err) {
    console.error('updateMatchHoles', err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

/**
 * Clôturer une manche.
 * single → vainqueur avance
 * home_away → aller → retour → si égalité cumul trous → belle → vainqueur avance
 */
async function closeMatch(req, res) {
  try {
    const match = await MatchPlayMatch.findByPk(req.params.id, {
      include: [{ model: MatchPlayChampionship, as: 'championship' }],
    });
    if (!match) return res.status(404).json({ error: 'Match introuvable' });
    if (match.is_bye) return res.status(400).json({ error: 'Bye — déjà qualifié' });
    if (match.status === 'closed') {
      return res.status(400).json({ error: 'Match déjà terminé' });
    }
    if (!match.player_a_id || !match.player_b_id || match.player_a_id === match.player_b_id) {
      return res.status(400).json({ error: 'Match incomplet ou invalide' });
    }

    const { holes_won_a, holes_won_b } = summarizeHoles(match.holes_data);
    if (holes_won_a === holes_won_b) {
      return res.status(400).json({
        error:
          'Égalité sur cette manche : continuez les trous (ou jouez jusqu\'à départager) avant de clôturer.',
      });
    }

    const legWinnerId = holes_won_a > holes_won_b ? match.player_a_id : match.player_b_id;
    await match.update({
      status: 'closed',
      holes_won_a,
      holes_won_b,
      winner_id: legWinnerId,
    });

    const champ = match.championship;
    let message = 'Manche terminée';
    let next_match = null;
    let series_winner_id = null;

    // ——— Championnat aller-retour ———
    if (champ && champ.format === 'home_away' && match.series_key) {
      // Recharger toutes les manches de la série
      const siblings = await MatchPlayMatch.findAll({
        where: { series_key: match.series_key },
        order: [['leg', 'ASC']],
      });
      const aller = siblings.find((s) => s.leg === 1);
      const retour = siblings.find((s) => s.leg === 2);
      const belleExisting = siblings.find((s) => s.leg === 3);

      if (match.leg === 1) {
        // Créer le retour (joueurs inversés)
        next_match = await MatchPlayMatch.create({
          championship_id: match.championship_id,
          player_a_id: match.player_b_id,
          player_b_id: match.player_a_id,
          round_size: match.round_size,
          bracket_slot: match.bracket_slot,
          leg: 2,
          series_key: match.series_key,
          status: 'pending',
          holes_data: [],
          is_bye: false,
          created_by: req.user.id,
        });
        message = 'Aller terminé — match retour créé';
        return res.json({ match, next_match, message });
      }

      if (match.leg === 2 && aller) {
        // Cumul des trous gagnés pour les joueurs d'origine (aller)
        // Aller : A=origA, B=origB
        // Retour : A=origB, B=origA  → trous de origA = aller.a + retour.b
        const origA = aller.player_a_id;
        const origB = aller.player_b_id;
        const totalOrigA = Number(aller.holes_won_a || 0) + Number(match.holes_won_b || 0);
        const totalOrigB = Number(aller.holes_won_b || 0) + Number(match.holes_won_a || 0);

        if (totalOrigA === totalOrigB) {
          if (!belleExisting) {
            next_match = await MatchPlayMatch.create({
              championship_id: match.championship_id,
              player_a_id: origA,
              player_b_id: origB,
              round_size: match.round_size,
              bracket_slot: match.bracket_slot,
              leg: 3,
              series_key: match.series_key,
              status: 'pending',
              holes_data: [],
              is_bye: false,
              created_by: req.user.id,
            });
          }
          message = `Égalité ${totalOrigA}-${totalOrigB} après A/R — la belle est créée`;
          return res.json({ match, next_match, message, series_tied: true });
        }

        series_winner_id = totalOrigA > totalOrigB ? origA : origB;
        message = `Série A/R terminée (${totalOrigA}-${totalOrigB})`;
        await advanceWinner(
          champ,
          match.round_size,
          match.bracket_slot,
          series_winner_id,
          req.user.id
        );
        return res.json({ match, series_winner_id, message });
      }

      if (match.leg === 3) {
        series_winner_id = legWinnerId;
        message = 'Belle terminée — vainqueur qualifié';
        await advanceWinner(
          champ,
          match.round_size,
          match.bracket_slot,
          series_winner_id,
          req.user.id
        );
        return res.json({ match, series_winner_id, message });
      }
    }

    // ——— Match unique (libre ou championnat single) ———
    if (champ && (champ.format === 'single' || !match.series_key)) {
      series_winner_id = legWinnerId;
      await advanceWinner(
        champ,
        match.round_size,
        match.bracket_slot,
        legWinnerId,
        req.user.id
      );
      message =
        match.round_size === 2
          ? 'Finale terminée — champion désigné'
          : 'Match terminé — vainqueur qualifié pour le tour suivant';
    } else if (!champ) {
      message = 'Match libre terminé';
    }

    res.json({ match, series_winner_id, message });
  } catch (err) {
    console.error('closeMatch', err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

