async function addRegistrations(req, res) {
  try {
    const { MarcassinsRegistration } = require('../models');
    const edition = await MarcassinsEdition.findByPk(req.params.id);
    if (!edition || edition.status === 'closed') {
      return res.status(400).json({ error: 'Édition indisponible' });
    }
