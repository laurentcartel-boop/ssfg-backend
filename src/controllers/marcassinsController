} = require('../models');

function pairKey(a, b) {
  return [a, b].sort().join('|');
}

function sumHoles(arr) {
  if (!Array.isArray(arr)) return null;
  const nums = arr.map((n) => Number(n)).filter((n) => n >= 1);
  if (!nums.length) return null;
  return nums.reduce((s, n) => s + n, 0);
}

function teeCounts(tees, aId, bId) {
  const list = Array.isArray(tees) ? tees : [];
  let a = 0;
  let b = 0;
  list.forEach((id) => {
    if (id === aId) a += 1;
    else if (id === bId) b += 1;
  });
  return { a, b };
}

function serializeTeam(t, quota = 6) {
  const morning = sumHoles(t.morning_holes);
  const afternoon = sumHoles(t.afternoon_holes);
  const total =
    morning != null || afternoon != null
      ? (morning || 0) + (afternoon || 0)
      : null;
  const tees = teeCounts(t.afternoon_tees, t.player_a_id, t.player_b_id);
  return {
    id: t.id,
    label: t.label,
    is_defending: t.is_defending,
    player_a: t.playerA,
    player_b: t.playerB,
    player_a_id: t.player_a_id,
    player_b_id: t.player_b_id,
    morning_holes: t.morning_holes || [],
    afternoon_holes: t.afternoon_holes || [],
    afternoon_tees: t.afternoon_tees || [],
    morning_total: morning,
    afternoon_total: afternoon,
    total,
    tee_a: tees.a,
    tee_b: tees.b,
    tee_ok: tees.a >= quota && tees.b >= quota,
    morning_round_id: t.morning_round_id,
    afternoon_round_id: t.afternoon_round_id,
  };
}

async function eligibleDefendingPair(year) {
  const prev = await MarcassinsEdition.findOne({
    where: { year: year - 1, status: 'closed' },
    include: [{ model: MarcassinsTeam, as: 'winner' }],
  });
  if (!prev || !prev.winner) return null;
  // S'ils défendaient déjà l'an passé, plus le droit cette année
  if (prev.winner.is_defending) return null;
  return {
    player_a_id: prev.winner.player_a_id,
    player_b_id: prev.winner.player_b_id,
    edition_year: prev.year,
  };
}


async function createLiveRoundsForEdition(edition, userId) {
  const { Round, RoundPlayer, User } = require('../models');
  const teams = await MarcassinsTeam.findAll({
    where: { edition_id: edition.id },
    include: [
      { model: User, as: 'playerA' },
      { model: User, as: 'playerB' },
    ],
  });
  const today = new Date().toISOString().slice(0, 10);
  const courseId = edition.course_id;
  let created = 0;
  for (const team of teams) {
    if (team.morning_round_id && team.afternoon_round_id) continue;
    const a = team.playerA;
    const b = team.playerB;
    const duo = `${(a && a.last_name) || '?'} / ${(b && b.last_name) || '?'}`;
    async function makeRound(label) {
      const round = await Round.create({
        name: `Marcassins ${edition.year} · ${label} · ${duo}`,
        type: 'entrainement',
        course_id: courseId,
        date: today,
        status: 'in_progress',
        created_by: userId,
      });
      for (const uid of [team.player_a_id, team.player_b_id]) {
        const u = await User.findByPk(uid);
        await RoundPlayer.create({
          round_id: round.id,
          user_id: uid,
          starting_index: u ? u.index_value : 1,
        });
      }
      return round.id;
    }
    const patch = {};
    if (!team.morning_round_id) patch.morning_round_id = await makeRound('Matin');
    if (!team.afternoon_round_id) patch.afternoon_round_id = await makeRound('AM');
    await team.update(patch);
    created += 1;
  }
  return created;
}

async function listEditions(req, res) {
  try {
    const editions = await MarcassinsEdition.findAll({
      include: [
        { model: Course, as: 'course', attributes: ['id', 'name', 'short_name'] },
        {
          model: MarcassinsTeam,
          as: 'winner',
          include: [
            { model: User, as: 'playerA', attributes: ['id', 'first_name', 'last_name'] },
            { model: User, as: 'playerB', attributes: ['id', 'first_name', 'last_name'] },
          ],
        },
      ],
      order: [['year', 'DESC']],
    });
    res.json({ editions, index_counts: false });
  } catch (err) {
    console.error('listEditions marcassins', err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function getEdition(req, res) {
  try {
    const edition = await MarcassinsEdition.findByPk(req.params.id, {
      include: [
        { model: Course, as: 'course' },
        {
          model: MarcassinsTeam,
          as: 'teams',
          include: [
            { model: User, as: 'playerA', attributes: ['id', 'first_name', 'last_name', 'index_value'] },
            { model: User, as: 'playerB', attributes: ['id', 'first_name', 'last_name', 'index_value'] },
          ],
        },
      ],
    });
    if (!edition) return res.status(404).json({ error: 'Édition introuvable' });

    const teams = (edition.teams || [])
      .map((t) => serializeTeam(t, edition.tee_quota))
      .sort((a, b) => {
        if (a.total == null && b.total == null) return 0;
        if (a.total == null) return 1;
        if (b.total == null) return -1;
        return a.total - b.total;
      });

    const defending = await eligibleDefendingPair(edition.year);
    res.json({
      edition,
      teams,
      defending_eligible: defending,
      hors_index: true,
    });
  } catch (err) {
    console.error('getEdition marcassins', err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function createEdition(req, res) {
  try {
    const year = Number(req.body.year) || new Date().getFullYear();
    const date = req.body.date || `${year}-01-01`;
    const existing = await MarcassinsEdition.findOne({ where: { year } });
    if (existing) {
      return res.status(409).json({ error: `Édition ${year} déjà créée` });
    }
    const edition = await MarcassinsEdition.create({
      name: req.body.name || 'Trophée des Marcassins',
      year,
      date,
      course_id: req.body.course_id || null,
      tee_quota: Number(req.body.tee_quota) || 6,
      status: 'setup',
      created_by: req.user.id,
    });

    const def = await eligibleDefendingPair(year);
    if (def) {
      await MarcassinsTeam.create({
        edition_id: edition.id,
        player_a_id: def.player_a_id,
        player_b_id: def.player_b_id,
        is_defending: true,
        label: 'Tenants du titre',
      });
    }
    res.status(201).json({ edition, defending: def, message: 'Édition créée (hors index)' });
  } catch (err) {
    console.error('createEdition marcassins', err);
    res.status(500).json({ error: 'Erreur serveur', detail: err.message });
  }
}

async function addTeam(req, res) {
  try {
    const edition = await MarcassinsEdition.findByPk(req.params.id);
    if (!edition) return res.status(404).json({ error: 'Édition introuvable' });
    if (edition.status === 'closed') {
      return res.status(400).json({ error: 'Édition clôturée' });
    }
    const { player_a_id, player_b_id, label, is_defending } = req.body;
    if (!player_a_id || !player_b_id || player_a_id === player_b_id) {
      return res.status(400).json({ error: 'Deux joueurs distincts requis' });
    }
    const teams = await MarcassinsTeam.findAll({ where: { edition_id: edition.id } });
    const used = new Set();
    teams.forEach((t) => {
      used.add(t.player_a_id);
      used.add(t.player_b_id);
    });
    if (used.has(player_a_id) || used.has(player_b_id)) {
      return res.status(400).json({ error: 'Un des joueurs est déjà dans un duo' });
    }
    const team = await MarcassinsTeam.create({
      edition_id: edition.id,
      player_a_id,
      player_b_id,
      label: label || null,
      is_defending: !!is_defending,
    });
    res.status(201).json({ team, message: 'Duo ajouté' });
  } catch (err) {
    console.error('addTeam marcassins', err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function removeTeam(req, res) {
  try {
    const edition = await MarcassinsEdition.findByPk(req.params.id);
    if (!edition || edition.status === 'closed') {
      return res.status(400).json({ error: 'Impossible' });
