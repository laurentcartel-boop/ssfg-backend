    await MarcassinsTeam.destroy({
      where: { id: req.params.teamId, edition_id: edition.id },
    });
    res.json({ message: 'Duo retiré' });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

/** Body: { pairs: [{ player_a_id, player_b_id, label? }] } ou { player_ids: [] } pour tirage */
async function drawTeams(req, res) {
  try {
    const edition = await MarcassinsEdition.findByPk(req.params.id, {
      include: [{ model: MarcassinsTeam, as: 'teams' }],
    });
    if (!edition) return res.status(404).json({ error: 'Édition introuvable' });
    if (edition.status === 'closed') {
      return res.status(400).json({ error: 'Édition clôturée' });
    }

    if (Array.isArray(req.body.pairs) && req.body.pairs.length) {
      for (const p of req.body.pairs) {
        await addTeam(
          { ...req, body: p, params: { id: edition.id } },
          { status() { return this; }, json() {}, statusCode: 200 }
        );
      }
    }

    const ids = req.body.player_ids || [];
    if (ids.length) {
      const used = new Set();
      (edition.teams || []).forEach((t) => {
        used.add(t.player_a_id);
        used.add(t.player_b_id);
      });
      const pool = ids.filter((id) => !used.has(id));
      for (let i = pool.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }
      const leftover = [];
      for (let i = 0; i + 1 < pool.length; i += 2) {
        await MarcassinsTeam.create({
          edition_id: edition.id,
          player_a_id: pool[i],
          player_b_id: pool[i + 1],
          is_defending: false,
        });
      }
      if (pool.length % 2 === 1) leftover.push(pool[pool.length - 1]);
      return res.json({
        message: 'Tirage effectué',
        leftover,
      });
    }
    res.json({ message: 'Rien à tirer' });
  } catch (err) {
    console.error('drawTeams', err);
    res.status(500).json({ error: 'Erreur serveur', detail: err.message });
  }
}

async function updateScores(req, res) {
  try {
    const edition = await MarcassinsEdition.findByPk(req.params.id);
    if (!edition) return res.status(404).json({ error: 'Édition introuvable' });
    if (edition.status === 'closed') {
      return res.status(400).json({ error: 'Édition clôturée' });
    }
    const team = await MarcassinsTeam.findOne({
      where: { id: req.params.teamId, edition_id: edition.id },
    });
    if (!team) return res.status(404).json({ error: 'Duo introuvable' });

    const patch = {};
    if (Array.isArray(req.body.morning_holes)) patch.morning_holes = req.body.morning_holes;
    if (Array.isArray(req.body.afternoon_holes)) patch.afternoon_holes = req.body.afternoon_holes;
    if (Array.isArray(req.body.afternoon_tees)) patch.afternoon_tees = req.body.afternoon_tees;
    if (req.body.label !== undefined) patch.label = req.body.label;
    await team.update(patch);
    const full = await MarcassinsTeam.findByPk(team.id, {
      include: [
        { model: User, as: 'playerA', attributes: ['id', 'first_name', 'last_name'] },
        { model: User, as: 'playerB', attributes: ['id', 'first_name', 'last_name'] },
      ],
    });
    res.json({ team: serializeTeam(full, edition.tee_quota), hors_index: true });
  } catch (err) {
    console.error('updateScores marcassins', err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function setStatus(req, res) {
  try {
    const edition = await MarcassinsEdition.findByPk(req.params.id, {
      include: [{ model: MarcassinsTeam, as: 'teams' }],
    });
    if (!edition) return res.status(404).json({ error: 'Édition introuvable' });
    const status = req.body.status;
    if (!['setup', 'live', 'closed'].includes(status)) {
      return res.status(400).json({ error: 'Statut invalide' });
    }

    if (status === 'live') {
      const n = (edition.teams || []).length;
      if (n === 0) {
        await composePairsFromEdition(edition.id);
      }
      const fresh = await MarcassinsEdition.findByPk(edition.id);
      await createLiveRoundsForEdition(fresh || edition, req.user.id);
      await edition.update({ status: 'live' });
    } else if (status === 'closed') {
      const ranked = (edition.teams || [])
        .map((t) => serializeTeam(t, edition.tee_quota))
        .filter((t) => t.total != null)
        .sort((a, b) => a.total - b.total);
      const winnerId = ranked[0]?.id || null;
      await edition.update({ status: 'closed', winner_team_id: winnerId });
    } else {
      await edition.update({ status });
    }
    res.json({ edition, message: `Statut : ${status}` });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function deleteEdition(req, res) {
