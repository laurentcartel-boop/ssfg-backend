const { Op } = require('sequelize');
const { User, Club, Course, Competition } = require('../models');

const CLUB_ALIASES = {
  SSFG: 'SSFG',
  AFG: 'AFG',
  HAC: 'HAC',
  RMFC: 'RMFC',
  'SANS CLUB': 'NONE',
  'SANSCLUB': 'NONE',
  NONE: 'NONE',
};

function norm(s) {
  return String(s || '')
    .trim()
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');
}

function mapClubCode(raw) {
  const k = norm(raw).toUpperCase().replace(/\s+/g, ' ');
  if (!k) return 'NONE';
  if (CLUB_ALIASES[k]) return CLUB_ALIASES[k];
  const compact = k.replace(/\s/g, '');
  if (CLUB_ALIASES[compact]) return CLUB_ALIASES[compact];
  return 'NONE';
}

function excelSerialToIso(n) {
  // Excel serial date (jours depuis 1899-12-30, avec bug 1900)
  const ms = Math.round((n - 25569) * 86400 * 1000);
  const d = new Date(ms);
  if (Number.isNaN(d.getTime())) return null;
  const y = d.getUTCFullYear();
  const mo = String(d.getUTCMonth() + 1).padStart(2, '0');
  const day = String(d.getUTCDate()).padStart(2, '0');
  return `${y}-${mo}-${day}`;
}

function parseBirth(raw) {
  if (raw == null || raw === '') return null;

  // Objet Date (xlsx cellDates: true)
  if (raw instanceof Date && !Number.isNaN(raw.getTime())) {
    const y = raw.getFullYear();
    const mo = String(raw.getMonth() + 1).padStart(2, '0');
    const day = String(raw.getDate()).padStart(2, '0');
    return sanitizeBirthIso(`${y}-${mo}-${day}`);
  }
  // Date sérialisée JSON / string ISO complète
  if (typeof raw === 'object' && raw !== null && raw.toISOString) {
    try {
      return sanitizeBirthIso(raw.toISOString().slice(0, 10));
    } catch (e) {}
  }

  // Numéro de série Excel (souvent renvoyé par xlsx)
  if (typeof raw === 'number' && raw > 20000 && raw < 60000) {
    return sanitizeBirthIso(excelSerialToIso(raw));
  }

  let s = String(raw).trim();
  // "Fri Jun 05 1981 00:00:00 GMT+..." 
  const asDate = new Date(s);
  if (!Number.isNaN(asDate.getTime()) && /[a-zA-Z]/.test(s) && s.length > 10) {
    const y = asDate.getFullYear();
    const mo = String(asDate.getMonth() + 1).padStart(2, '0');
    const day = String(asDate.getDate()).padStart(2, '0');
    return sanitizeBirthIso(`${y}-${mo}-${day}`);
  }

  // Date JS sérialisée
  if (/^\d{4}-\d{2}-\d{2}/.test(s)) {
    return sanitizeBirthIso(s.slice(0, 10));
  }

  // Format HelloAsso / FR : 21/05/1965 ou 21-05-1965 ou 21.05.1965
  let m = s.match(/^(\d{1,2})[/.-](\d{1,2})[/.-](\d{4})$/);
  if (m) {
    const day = m[1].padStart(2, '0');
    const mo = m[2].padStart(2, '0');
    return sanitizeBirthIso(`${m[3]}-${mo}-${day}`);
  }

  // Texte FR : "21 mai 1965"
  const monthsFr = {
    janvier: '01', janv: '01',
    fevrier: '02', 'février': '02', fevr: '02',
    mars: '03',
    avril: '04',
    mai: '05',
    juin: '06',
    juillet: '07', juil: '07',
    aout: '08', 'août': '08',
    septembre: '09', sept: '09',
    octobre: '10', oct: '10',
    novembre: '11', nov: '11',
    decembre: '12', 'décembre': '12', dec: '12',
  };
  m = s.toLowerCase().match(/^(\d{1,2})\s+([a-zéûô]+)\.?\s+(\d{4})$/i);
  if (m) {
    const day = m[1].padStart(2, '0');
    const mo = monthsFr[m[2].toLowerCase()];
    if (mo) return sanitizeBirthIso(`${m[3]}-${mo}-${day}`);
  }

  // Nombre en texte (série Excel)
  const num = Number(s);
  if (!Number.isNaN(num) && num > 20000 && num < 60000) {
    return sanitizeBirthIso(excelSerialToIso(num));
  }

  return null;
}

/** Corrige fautes type 2965 → 1965 et valide la plage */
function sanitizeBirthIso(iso) {
  if (!iso) return null;
  const m = String(iso).slice(0, 10).match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return null;
  let y = Number(m[1]);
  // Faute de frappe fréquente 29xx / 28xx au lieu de 19xx
  if (y >= 2800 && y <= 2999) y -= 1000;
  if (y < 1920 || y > 2018) return null;
  return `${y}-${m[2]}-${m[3]}`;
}

function rowKey(r) {
  return `${norm(r.last_name)}|${norm(r.first_name)}`;
}

/**
 * Normalise une ligne HelloAsso (clés FR export).
 */
function normalizeRow(raw) {
  const get = (...keys) => {
    for (const k of keys) {
      if (raw[k] != null && String(raw[k]).trim() !== '') return String(raw[k]).trim();
    }
    return '';
  };
  return {
    ticket: get('Numéro de billet', 'Numero de billet', 'ticket', 'num_billet'),
    status: get('Statut de la commande', 'status'),
    last_name: get('Nom participant', 'Nom', 'last_name'),
    first_name: get('Prénom participant', 'Prenom participant', 'Prénom', 'first_name'),
    email: get(
      'Email participant',
      'Email du participant',
      'Email payeur',
      'email'
    )
      .toLowerCase()
      .trim(),
    birth_date: parseBirth(get('Date de naissance', 'birth_date')),
    club_raw: get('Club', 'club'),
    arrival: get("Horaires d'arrivée", "Horaires d'arrivee", 'arrival'),
    order_ref: get('Référence commande', 'Reference commande', 'order_ref'),
  };
}

function isValidated(status) {
  const s = norm(status);
  return !s || s.includes('valid');
}

/**
 * POST /api/import/helloasso
 * Body: {
 *   name, course_id, date, competition_id?,
 *   dry_run?: boolean,
 *   rows: [ { ...colonnes HelloAsso } ]
 * }
 */
async function importHelloAsso(req, res) {
  try {
    let {
      name,
      course_id,
      date,
      competition_id,
      dry_run = false,
      rows: rawRows = [],
      file_base64,
    } = req.body;

    if ((!Array.isArray(rawRows) || rawRows.length === 0) && file_base64) {
      try {
        const XLSX = require('xlsx');
        const b64 = String(file_base64).replace(/^data:[^;]+;base64,/, '');
        const buf = Buffer.from(b64, 'base64');
        const wb = XLSX.read(buf, { type: 'buffer', cellDates: true, raw: false });
        const sheet = wb.Sheets[wb.SheetNames[0]];
        rawRows = XLSX.utils.sheet_to_json(sheet, { defval: '', raw: false });
      } catch (e) {
        return res.status(400).json({
          error:
            'Lecture Excel impossible. Installez la dépendance xlsx sur le backend, ou envoyez rows JSON / CSV.',
          detail: e.message,
        });
      }
    }

    if (!Array.isArray(rawRows) || rawRows.length === 0) {
      return res.status(400).json({ error: 'Aucune ligne à importer' });
    }
    if (!dry_run) {
      if (!name || !course_id || !date) {
        return res.status(400).json({
          error: 'name, course_id et date obligatoires (sauf dry_run)',
        });
      }
      const course = await Course.findByPk(course_id);
      if (!course) return res.status(404).json({ error: 'Parcours non trouvé' });
    }

    const clubs = await Club.findAll();
    const clubByCode = Object.fromEntries(clubs.map((c) => [c.code, c]));

    const rows = rawRows
      .map(normalizeRow)
      .filter((r) => r.last_name && r.first_name && isValidated(r.status));

    // Emails apparaissant pour plusieurs participants différents
    const emailToKeys = new Map();
    for (const r of rows) {
      if (!r.email || !r.email.includes('@')) continue;
      const k = rowKey(r);
      if (!emailToKeys.has(r.email)) emailToKeys.set(r.email, new Set());
      emailToKeys.get(r.email).add(k);
    }
    const sharedEmails = new Set(
      [...emailToKeys.entries()]
        .filter(([, set]) => set.size > 1)
        .map(([email]) => email)
    );

    const existingUsers = await User.findAll({
      attributes: [
        'id',
        'email',
        'first_name',
        'last_name',
        'club_id',
        'birth_date',
        'index_value',
      ],
    });
    const byEmail = new Map(
      existingUsers.filter((u) => u.email).map((u) => [u.email.toLowerCase(), u])
    );
    const byName = new Map();
    for (const u of existingUsers) {
      byName.set(`${norm(u.last_name)}|${norm(u.first_name)}`, u);
    }

    const preview = [];
    const tempPassword = 'Footgolf2026!';

    for (const r of rows) {
      const clubCode = mapClubCode(r.club_raw);
      const club = clubByCode[clubCode] || clubByCode.NONE || null;

      let emailToUse = r.email && r.email.includes('@') ? r.email : '';
      let emailNote = '';

      if (emailToUse && sharedEmails.has(emailToUse)) {
        emailToUse = '';
        emailNote = 'Email payeur partagé (plusieurs inscrits) — non attribué';
      }

      let existing = null;
      if (emailToUse && byEmail.has(emailToUse)) {
        existing = byEmail.get(emailToUse);
        // Si l'email existe mais nom très différent → ne pas fusionner
        const sameName =
          norm(existing.last_name) === norm(r.last_name) &&
          norm(existing.first_name) === norm(r.first_name);
        if (!sameName) {
          existing = byName.get(rowKey(r)) || null;
          emailToUse = '';
          emailNote =
            'Email déjà utilisé par un autre joueur — compte sans cet email';
        }
      } else {
        existing = byName.get(rowKey(r)) || null;
      }

      if (!existing && !emailToUse) {
        // email synthétique unique (contrainte NOT NULL + unique)
        const ticket = r.ticket || `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
        emailToUse = `import.${ticket}@ssfg.local`.toLowerCase();
        emailNote = emailNote || 'Pas d’email participant — email technique provisoire';
      }

      const action = existing ? 'exists' : 'create';
      preview.push({
        action,
        ticket: r.ticket,
        first_name: r.first_name,
        last_name: r.last_name,
        email: existing ? existing.email : emailToUse,
        club_code: clubCode,
        birth_date: r.birth_date,
        arrival: r.arrival,
        note: emailNote,
        user_id: existing ? existing.id : null,
        _emailForCreate: emailToUse,
        _club_id: club ? club.id : null,
      });
    }

    if (dry_run) {
      return res.json({
        dry_run: true,
        total: preview.length,
        to_create: preview.filter((p) => p.action === 'create').length,
        existing: preview.filter((p) => p.action === 'exists').length,
        rows: preview.map(({ _emailForCreate, _club_id, ...rest }) => rest),
      });
    }

    const created = [];
    const linked = [];

    for (const p of preview) {
      if (p.action === 'exists') {
        // MAJ club / naissance si vide
        const u = await User.findByPk(p.user_id);
        if (u) {
          const patch = {};
          if (!u.club_id && p._club_id) patch.club_id = p._club_id;
          // Toujours (ré)écrire la date si l'import en a une valide
          if (p.birth_date) patch.birth_date = p.birth_date;
          if (Object.keys(patch).length) await u.update(patch);
          linked.push({ id: u.id, name: `${u.last_name} ${u.first_name}` });
        }
        continue;
      }

      let email = p._emailForCreate;
      // éviter collision
      let n = 0;
      while (await User.findOne({ where: { email } })) {
        n += 1;
        email = p._emailForCreate.replace('@', `+${n}@`);
      }

      const user = await User.create({
        email,
        password_hash: tempPassword,
        first_name: p.first_name,
        last_name: p.last_name,
        role: 'joueur',
        birth_date: p.birth_date,
        club_id: p._club_id,
        index_value: 1.0,
        must_change_password: true,
        is_active: true,
      });
      byEmail.set(email, user);
      byName.set(rowKey(p), user);
      created.push({
        id: user.id,
        name: `${user.last_name} ${user.first_name}`,
        email: user.email,
      });
      p.user_id = user.id;
    }

    let competition = null;
    if (competition_id) {
      competition = await Competition.findByPk(competition_id);
      if (!competition) {
        return res.status(404).json({ error: 'Compétition non trouvée' });
      }
    } else {
      competition = await Competition.create({
        name: String(name).trim(),
        course_id,
        date,
        status: 'open',
        created_by: req.user.id,
      });
    }

    res.status(201).json({
      message: 'Import HelloAsso terminé',
      competition: {
        id: competition.id,
        name: competition.name,
        date: competition.date,
      },
      created_count: created.length,
      existing_count: linked.length,
      created,
      existing: linked,
      temp_password: tempPassword,
      hint: 'Créez les squads depuis la compétition. Mot de passe temporaire pour les nouveaux comptes.',
    });
  } catch (err) {
    console.error('importHelloAsso', err);
    res.status(500).json({ error: 'Erreur serveur', detail: err.message });
  }
}

module.exports = { importHelloAsso };
