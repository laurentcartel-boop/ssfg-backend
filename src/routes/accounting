const express = require('express');
const router = express.Router();
const ctrl = require('../controllers/accountingController');
const { authenticate, requireRole } = require('../middleware/auth');

router.use(authenticate);
router.use(requireRole('super_admin'));

router.get('/accounts', ctrl.listAccounts);
router.get('/years', ctrl.years);
router.get('/summary', ctrl.summary);
router.get('/', ctrl.listEntries);
router.post('/', ctrl.createEntry);
router.post('/import', ctrl.importEntries);
router.put('/:id', ctrl.updateEntry);
router.delete('/year/:year', ctrl.deleteYear);
router.delete('/:id', ctrl.deleteEntry);

module.exports = router;
