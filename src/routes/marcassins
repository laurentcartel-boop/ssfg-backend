const express = require('express');
const router = express.Router();
const ctrl = require('../controllers/marcassinsController');
const { authenticate, requireRole } = require('../middleware/auth');

router.use(authenticate);

router.get('/', ctrl.listEditions);
router.get('/:id', ctrl.getEdition);
router.post('/', requireRole('super_admin', 'platine_admin'), ctrl.createEdition);
router.post('/:id/teams', requireRole('super_admin', 'platine_admin'), ctrl.addTeam);
router.delete('/:id/teams/:teamId', requireRole('super_admin', 'platine_admin'), ctrl.removeTeam);
router.post('/:id/draw', requireRole('super_admin', 'platine_admin'), ctrl.drawTeams);
router.patch('/:id/teams/:teamId', requireRole('super_admin', 'platine_admin'), ctrl.updateScores);
router.post('/:id/status', requireRole('super_admin', 'platine_admin'), ctrl.setStatus);
router.delete('/:id', requireRole('super_admin', 'platine_admin'), ctrl.deleteEdition);
router.get('/:id/registrations', ctrl.listRegistrations);
router.post('/:id/registrations', requireRole('super_admin', 'platine_admin'), ctrl.addRegistrations);
router.post('/:id/forced-pairs', requireRole('super_admin', 'platine_admin'), ctrl.setForcedPairs);
router.post('/:id/compose-pairs', requireRole('super_admin', 'platine_admin'), ctrl.composePairs);
router.post('/:id/live-rounds', requireRole('super_admin', 'platine_admin'), ctrl.ensureLiveRounds);

module.exports = router;
