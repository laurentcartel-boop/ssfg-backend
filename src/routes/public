/** Post public (sans login) — pseudo + message */
router.post('/rounds/:id/comments', async (req, res) => {
  try {
    const { Round, RoundComment } = require('../models');
    const round = await Round.findByPk(req.params.id);
    if (!round) return res.status(404).json({ error: 'Partie non trouvée' });
    if (round.status === 'closed') {
      return res.status(400).json({ error: 'Partie terminée' });
    }
    const message = String(req.body.message || '').trim().slice(0, 280);
    let display_name = String(req.body.display_name || req.body.name || '')
      .trim()
      .slice(0, 40);
    if (!message) return res.status(400).json({ error: 'Message vide' });
    if (!display_name) display_name = 'Anonyme';
    // anti-spam basique : max 20 messages / 5 min pour ce pseudo sur cette partie
    const { Op } = require('sequelize');
    const since = new Date(Date.now() - 5 * 60 * 1000);
    const recent = await RoundComment.count({
      where: {
        round_id: round.id,
        display_name,
        createdAt: { [Op.gte]: since },
      },
    });
    if (recent >= 20) {
      return res.status(429).json({ error: 'Trop de messages, patiente un peu' });
    }
    const c = await RoundComment.create({
      round_id: round.id,
      user_id: null,
      display_name,
      message,
    });
    res.status(201).json({
      comment: {
        id: c.id,
        message: c.message,
        created_at: c.createdAt,
        display_name: c.display_name,
        user: null,
      },
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
});

