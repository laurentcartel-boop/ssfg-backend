const express = require('express');
const router = express.Router();
const ctrl = require('../controllers/matchPlayController');
const { authenticate, requireRole } = require('../middleware/auth');

router.use(authenticate);

router.get('/matches', ctrl.listMatches);
router.get('/matches/:id', ctrl.getMatch);
router.post('/matches', ctrl.createLibreMatch);
router.put('/matches/:id/holes', ctrl.updateMatchHoles);
router.post('/matches/:id/close', ctrl.closeMatch);

router.get('/championships', ctrl.listChampionships);
router.get('/championships/:id', ctrl.getChampionship);
router.post('/championships', requireRole('super_admin', 'platine_admin'), ctrl.createChampionship);
router.post('/championships/:id/entrants', requireRole('super_admin', 'platine_admin'), ctrl.addEntrants);
router.post('/championships/:id/draw', requireRole('super_admin', 'platine_admin'), ctrl.drawBracket);
router.post('/championships/:id/close', requireRole('super_admin', 'platine_admin'), ctrl.closeChampionship);
router.delete('/championships/:id', requireRole('super_admin', 'platine_admin'), ctrl.deleteChampionship);
router.delete('/matches/:id', requireRole('super_admin', 'platine_admin'), ctrl.deleteMatch);

module.exports = router;
