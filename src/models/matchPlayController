    res.json({ championships: list });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function getChampionship(req, res) {
  try {
    const c = await MatchPlayChampionship.findByPk(req.params.id, {
      include: [
        { model: User, as: 'creator', attributes: ['id', 'first_name', 'last_name'] },
        {
          model: MatchPlayMatch,
          as: 'matches',
          include: [
            { model: User, as: 'playerA', attributes: ['id', 'first_name', 'last_name'] },
            { model: User, as: 'playerB', attributes: ['id', 'first_name', 'last_name'] },
            { model: User, as: 'winner', attributes: ['id', 'first_name', 'last_name'] },
          ],
        },
      ],
    });
    if (!c) return res.status(404).json({ error: 'Championnat introuvable' });

    const entrantIds = c.entrants || [];
    const players = entrantIds.length
      ? await User.findAll({
          where: { id: entrantIds },
          attributes: ['id', 'first_name', 'last_name', 'index_value'],
        })
      : [];

    res.json({ championship: c, players });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function createChampionship(req, res) {
  try {
    const { name, format } = req.body;
    if (!name) return res.status(400).json({ error: 'Nom requis' });
    const c = await MatchPlayChampionship.create({
      name: name.trim(),
      format: format === 'home_away' ? 'home_away' : 'single',
      status: 'open',
      entrants: [],
      created_by: req.user.id,
    });
    res.status(201).json({ championship: c, message: 'Championnat Match Play créé' });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function addEntrants(req, res) {
  try {
    const c = await MatchPlayChampionship.findByPk(req.params.id);
    if (!c) return res.status(404).json({ error: 'Championnat introuvable' });
    if (c.status !== 'open') {
      return res.status(400).json({ error: 'Inscriptions fermées (tableau déjà tiré)' });
    }
    const ids = req.body.player_ids || [];
    if (!Array.isArray(ids) || ids.length === 0) {
      return res.status(400).json({ error: 'player_ids requis' });
    }
    const set = new Set([...(c.entrants || []), ...ids]);
    await c.update({ entrants: [...set] });
    res.json({ championship: c, message: 'Inscrits mis à jour' });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

/** Tirage + génération du 1er tour */
async function drawBracket(req, res) {
  try {
    const c = await MatchPlayChampionship.findByPk(req.params.id);
    if (!c) return res.status(404).json({ error: 'Championnat introuvable' });
    if (c.status !== 'open') {
      return res.status(400).json({ error: 'Tableau déjà généré' });
    }
    const entrants = shuffle(c.entrants || []);
    if (entrants.length < 2) {
      return res.status(400).json({ error: 'Au moins 2 inscrits' });
    }

    const size = nextPowerOf2(entrants.length);
    // Byes : on place null pour les places manquantes
    while (entrants.length < size) entrants.push(null);

    const created = [];
    for (let slot = 0; slot < size / 2; slot++) {
      const a = entrants[slot * 2];
      const b = entrants[slot * 2 + 1];
      if (!a && !b) continue;
      if (a && !b) {
        // Bye : vainqueur auto A → on crée un match closed
        const m = await MatchPlayMatch.create({
          championship_id: c.id,
          player_a_id: a,
          player_b_id: a,
          round_size: size,
          bracket_slot: slot,
          leg: 1,
          series_key: c.format === 'home_away' ? `${c.id}-R${size}-S${slot}` : null,
          status: 'closed',
          holes_data: [],
          holes_won_a: 1,
          holes_won_b: 0,
          winner_id: a,
          created_by: req.user.id,
        });
        created.push(m);
        await advanceWinner(c, size, slot, a, req.user.id);
        continue;
      }
      if (!a && b) {
        const m = await MatchPlayMatch.create({
          championship_id: c.id,
          player_a_id: b,
          player_b_id: b,
          round_size: size,
          bracket_slot: slot,
          leg: 1,
          series_key: c.format === 'home_away' ? `${c.id}-R${size}-S${slot}` : null,
          status: 'closed',
          holes_data: [],
          holes_won_a: 1,
          holes_won_b: 0,
          winner_id: b,
          created_by: req.user.id,
        });
        created.push(m);
        await advanceWinner(c, size, slot, b, req.user.id);
        continue;
      }

      const m = await MatchPlayMatch.create({
        championship_id: c.id,
        player_a_id: a,
        player_b_id: b,
        round_size: size,
        bracket_slot: slot,
        leg: 1,
        series_key: c.format === 'home_away' ? `${c.id}-R${size}-S${slot}` : null,
        status: 'pending',
        holes_data: [],
        created_by: req.user.id,
      });
      created.push(m);
    }

    await c.update({ status: 'in_progress' });
    res.json({ message: 'Tirage effectué', matches_created: created.length, bracket_size: size });
  } catch (err) {
    console.error('drawBracket', err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function closeChampionship(req, res) {
  try {
    const c = await MatchPlayChampionship.findByPk(req.params.id);
