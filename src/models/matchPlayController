  User,
} = require('../models');

function summarizeHoles(holes) {
  let a = 0;
  let b = 0;
  for (const h of holes || []) {
    if (h.result === 'a') a += 1;
    else if (h.result === 'b') b += 1;
  }
  return { holes_won_a: a, holes_won_b: b };
}

function nextPowerOf2(n) {
  let p = 1;
  while (p < n) p *= 2;
  return p;
}

function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

/** Liste matchs libres + mes matchs */
async function listMatches(req, res) {
  try {
    const where = {};
    if (req.query.championship_id) {
      where.championship_id = req.query.championship_id;
    } else if (req.query.libre === '1') {
      where.championship_id = null;
    }
    if (req.query.status) where.status = req.query.status;

    const matches = await MatchPlayMatch.findAll({
      where,
      order: [['createdAt', 'DESC']],
      limit: 100,
      include: [
        { model: User, as: 'playerA', attributes: ['id', 'first_name', 'last_name', 'index_value'] },
        { model: User, as: 'playerB', attributes: ['id', 'first_name', 'last_name', 'index_value'] },
        { model: User, as: 'winner', attributes: ['id', 'first_name', 'last_name'] },
      ],
    });
    res.json({ matches });
  } catch (err) {
    console.error('listMatches', err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function getMatch(req, res) {
  try {
