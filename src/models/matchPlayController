/** Créer un match libre (tout joueur connecté) */
async function createLibreMatch(req, res) {
  try {
    const { player_b_id } = req.body;
    if (!player_b_id) return res.status(400).json({ error: 'Adversaire requis' });
    if (player_b_id === req.user.id) {
      return res.status(400).json({ error: 'Choisissez un autre joueur' });
    }
    const opponent = await User.findByPk(player_b_id);
    if (!opponent) return res.status(404).json({ error: 'Adversaire introuvable' });

    const match = await MatchPlayMatch.create({
      championship_id: null,
      player_a_id: req.user.id,
      player_b_id,
      leg: 1,
      status: 'in_progress',
      holes_data: [],
      created_by: req.user.id,
    });

    const full = await MatchPlayMatch.findByPk(match.id, {
      include: [
        { model: User, as: 'playerA', attributes: ['id', 'first_name', 'last_name'] },
        { model: User, as: 'playerB', attributes: ['id', 'first_name', 'last_name'] },
      ],
    });
    res.status(201).json({ match: full, message: 'Match Play libre créé' });
  } catch (err) {
    console.error('createLibreMatch', err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

/**
 * PUT holes: { holes: [{ hole: 1, result: 'a'|'b'|'half' }, ...] }
 * Ou un seul trou: { hole: 1, result: 'a' }
 */
async function updateMatchHoles(req, res) {
  try {
    const match = await MatchPlayMatch.findByPk(req.params.id);
    if (!match) return res.status(404).json({ error: 'Match introuvable' });
    if (match.status === 'closed') {
      return res.status(400).json({ error: 'Match déjà terminé' });
    }

    let holes = Array.isArray(match.holes_data) ? [...match.holes_data] : [];

    if (req.body.holes && Array.isArray(req.body.holes)) {
      holes = req.body.holes;
    } else if (req.body.hole != null && req.body.result) {
      const hole = Number(req.body.hole);
      const result = req.body.result;
      if (!['a', 'b', 'half'].includes(result)) {
        return res.status(400).json({ error: 'result doit être a, b ou half' });
      }
      if (hole < 1 || hole > 18) {
        return res.status(400).json({ error: 'Trou invalide' });
      }
      const idx = holes.findIndex((h) => h.hole === hole);
      if (idx >= 0) holes[idx] = { hole, result };
      else holes.push({ hole, result });
      holes.sort((x, y) => x.hole - y.hole);
    } else {
      return res.status(400).json({ error: 'Données de score manquantes' });
    }

    const { holes_won_a, holes_won_b } = summarizeHoles(holes);
    if (match.status === 'pending') {
      await match.update({ status: 'in_progress' });
    }
    await match.update({ holes_data: holes, holes_won_a, holes_won_b });

    const full = await MatchPlayMatch.findByPk(match.id, {
      include: [
        { model: User, as: 'playerA', attributes: ['id', 'first_name', 'last_name'] },
        { model: User, as: 'playerB', attributes: ['id', 'first_name', 'last_name'] },
      ],
    });
    res.json({ match: full });
  } catch (err) {
    console.error('updateMatchHoles', err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

/**
 * Clôturer un match (leg). Calcule le vainqueur de la manche.
 * Si championnat home_away : crée retour ou belle si besoin, ou avance le vainqueur.
 */
async function closeMatch(req, res) {
  try {
    const match = await MatchPlayMatch.findByPk(req.params.id, {
      include: [{ model: MatchPlayChampionship, as: 'championship' }],
    });
    if (!match) return res.status(404).json({ error: 'Match introuvable' });
    if (match.status === 'closed') {
      return res.status(400).json({ error: 'Match déjà terminé' });
    }

    const { holes_won_a, holes_won_b } = summarizeHoles(match.holes_data);
    if (holes_won_a === holes_won_b) {
      return res.status(400).json({
        error: 'Égalité sur cette manche — jouez les trous restants ou une belle si déjà 18 trous',
      });
    }

    const winnerId = holes_won_a > holes_won_b ? match.player_a_id : match.player_b_id;
    await match.update({
      status: 'closed',
      holes_won_a,
      holes_won_b,
      winner_id: winnerId,
    });

    let message = 'Manche terminée';
    const champ = match.championship;

    if (champ && champ.format === 'home_away' && match.series_key) {
      const siblings = await MatchPlayMatch.findAll({
        where: { series_key: match.series_key },
      });
      const closed = siblings.filter((s) => s.status === 'closed');
      const legsDone = closed.length;

      // Cumul trous sur les manches terminées (hors belle pure : on cumule holes won)
      if (match.leg === 1) {
        // Créer le retour
        const retour = await MatchPlayMatch.create({
          championship_id: match.championship_id,
          player_a_id: match.player_b_id, // inversion terrain symbolique
          player_b_id: match.player_a_id,
          round_size: match.round_size,
          bracket_slot: match.bracket_slot,
          leg: 2,
          series_key: match.series_key,
          status: 'pending',
          holes_data: [],
          created_by: req.user.id,
        });
        message = 'Aller terminé — match retour créé';
        return res.json({ match, next_match: retour, message });
      }

      if (match.leg === 2) {
        // Cumul aller + retour (par joueur d'origine du series : player_a du leg 1)
        const aller = siblings.find((s) => s.leg === 1);
        // leg1: A vs B, leg2: B vs A (inversé)
        let totalOrigA = (aller?.holes_won_a || 0) + (match.holes_won_b || 0);
        let totalOrigB = (aller?.holes_won_b || 0) + (match.holes_won_a || 0);
        const origA = aller.player_a_id;
        const origB = aller.player_b_id;

        if (totalOrigA === totalOrigB) {
          const belle = await MatchPlayMatch.create({
            championship_id: match.championship_id,
            player_a_id: origA,
            player_b_id: origB,
            round_size: match.round_size,
            bracket_slot: match.bracket_slot,
            leg: 3,
            series_key: match.series_key,
            status: 'pending',
            holes_data: [],
            created_by: req.user.id,
          });
          message = 'Égalité après A/R — la belle est créée';
          return res.json({ match, next_match: belle, message });
        }

        const seriesWinner = totalOrigA > totalOrigB ? origA : origB;
        message = 'Série A/R terminée';
        await advanceWinner(champ, match.round_size, match.bracket_slot, seriesWinner, req.user.id);
        return res.json({ match, series_winner_id: seriesWinner, message });
      }

      if (match.leg === 3) {
        message = 'Belle terminée';
        await advanceWinner(champ, match.round_size, match.bracket_slot, winnerId, req.user.id);
        return res.json({ match, series_winner_id: winnerId, message });
      }
    }

    // Single match libre ou championnat format single
    if (champ && champ.format === 'single') {
      await advanceWinner(champ, match.round_size, match.bracket_slot, winnerId, req.user.id);
      message = 'Match terminé — vainqueur avancé si tableau';
    }

    res.json({ match, message });
  } catch (err) {
    console.error('closeMatch', err);
    res.status(500).json({ error: 'Erreur serveur' });
  }
}

async function advanceWinner(champ, roundSize, slot, winnerId, createdBy) {
  if (!champ || !roundSize || slot == null) return;
  const nextSize = roundSize / 2;
  if (nextSize < 1) return;

  const nextSlot = Math.floor(slot / 2);
  // Trouver ou créer le match suivant
  let next = await MatchPlayMatch.findOne({
    where: {
      championship_id: champ.id,
      round_size: nextSize,
      bracket_slot: nextSlot,
      leg: 1,
    },
  });

  if (!next) {
    // Créer avec un seul joueur pour l'instant — on met winner en A ou B selon slot pair/impair
    const isA = slot % 2 === 0;
    next = await MatchPlayMatch.create({
      championship_id: champ.id,
      player_a_id: isA ? winnerId : winnerId, // placeholder both same until second arrives - fix below
      player_b_id: winnerId,
      round_size: nextSize,
      bracket_slot: nextSlot,
      leg: 1,
      series_key: champ.format === 'home_away' ? `${champ.id}-R${nextSize}-S${nextSlot}` : null,
      status: 'pending',
      holes_data: [],
      created_by: createdBy,
    });
    // Mark temporary: store winner only in correct side via update after create
    if (isA) {
      await next.update({ player_a_id: winnerId, player_b_id: winnerId });
    } else {
      await next.update({ player_a_id: winnerId, player_b_id: winnerId });
    }
  }

  // Re-fetch and set correct player
  next = await MatchPlayMatch.findOne({
    where: {
      championship_id: champ.id,
      round_size: nextSize,
      bracket_slot: nextSlot,
      leg: 1,
    },
  });

  const isA = slot % 2 === 0;
  if (isA) {
    await next.update({ player_a_id: winnerId });
  } else {
    await next.update({ player_b_id: winnerId });
  }

  // Si A et B sont distincts → prêt
  const refreshed = await MatchPlayMatch.findByPk(next.id);
  if (refreshed.player_a_id !== refreshed.player_b_id) {
    await refreshed.update({ status: 'pending' });
  }
}

