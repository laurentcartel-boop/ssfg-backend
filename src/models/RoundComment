const { DataTypes } = require('sequelize');
const sequelize = require('../config/database');

const RoundComment = sequelize.define(
  'RoundComment',
  {
    id: {
      type: DataTypes.UUID,
      defaultValue: DataTypes.UUIDV4,
      primaryKey: true,
    },
    round_id: {
      type: DataTypes.UUID,
      allowNull: false,
    },
    user_id: {
      type: DataTypes.UUID,
      allowNull: false,
    },
    message: {
      type: DataTypes.STRING(280),
      allowNull: false,
    },
  },
  {
    tableName: 'round_comments',
    // Pas d'index sur createdAt : MySQL / sync plante si la colonne timestamps
    // n'est pas encore alignée (createdAt vs created_at)
    indexes: [{ fields: ['round_id'] }],
  }
);

module.exports = RoundComment;
