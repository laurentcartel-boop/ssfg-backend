const { DataTypes } = require('sequelize');
const sequelize = require('../config/database');

/**
 * holes_data: [{ hole: 1, result: 'a'|'b'|'half' }, ...]
 * is_bye: qualification automatique (nombre impair) — pas un vrai match
 * player_b_id null = en attente de l'autre vainqueur du tour précédent
 */
const MatchPlayMatch = sequelize.define(
  'MatchPlayMatch',
  {
    id: {
      type: DataTypes.UUID,
      defaultValue: DataTypes.UUIDV4,
      primaryKey: true,
    },
    championship_id: {
      type: DataTypes.UUID,
      allowNull: true,
    },
    player_a_id: {
      type: DataTypes.UUID,
      allowNull: true,
    },
    player_b_id: {
      type: DataTypes.UUID,
      allowNull: true,
    },
    round_size: {
      type: DataTypes.INTEGER,
      allowNull: true,
    },
    bracket_slot: {
      type: DataTypes.INTEGER,
      allowNull: true,
    },
    leg: {
      type: DataTypes.INTEGER,
      allowNull: false,
      defaultValue: 1,
    },
    series_key: {
      type: DataTypes.STRING(64),
      allowNull: true,
    },
    status: {
      type: DataTypes.ENUM('pending', 'in_progress', 'closed'),
      allowNull: false,
      defaultValue: 'pending',
    },
    holes_data: {
      type: DataTypes.JSON,
      allowNull: false,
      defaultValue: [],
    },
    holes_won_a: {
      type: DataTypes.INTEGER,
      allowNull: false,
      defaultValue: 0,
    },
    holes_won_b: {
      type: DataTypes.INTEGER,
      allowNull: false,
      defaultValue: 0,
    },
    winner_id: {
      type: DataTypes.UUID,
      allowNull: true,
    },
    is_bye: {
      type: DataTypes.BOOLEAN,
      allowNull: false,
      defaultValue: false,
    },
    created_by: {
      type: DataTypes.UUID,
      allowNull: false,
    },
  },
  { tableName: 'matchplay_matches' }
);

module.exports = MatchPlayMatch;
