const { DataTypes } = require('sequelize');
const sequelize = require('../config/database');

const CalendarMonth = sequelize.define(
  'CalendarMonth',
  {
    id: { type: DataTypes.UUID, defaultValue: DataTypes.UUIDV4, primaryKey: true },
    year: { type: DataTypes.INTEGER, allowNull: false },
    month: { type: DataTypes.INTEGER, allowNull: false },
    title: { type: DataTypes.STRING(160), allowNull: true },
    caption: { type: DataTypes.TEXT, allowNull: true },
    photo_url: { type: DataTypes.TEXT('long'), allowNull: true },
    event_date: { type: DataTypes.DATEONLY, allowNull: true },
  },
  {
    tableName: 'calendar_months',
    indexes: [{ unique: true, fields: ['year', 'month'] }],
  }
);

module.exports = CalendarMonth;
